{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/react"]
  },
  "include": ["src", "tests", "e2e", "vite.config.ts", "playwright.config.ts"],
  // Node-only script tests (no @types/node in this browser project); Vitest still runs them.
  "exclude": ["tests/scripts"]
}
